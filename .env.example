HOST=127.0.0.1       # 监听地址，仅本机访问用 127.0.0.1
PORT=8080            # 监听端口（与 OneBot V11 客户端配置一致）
SUPERUSERS=[]        # 管理员 QQ 号，如 ["123456789"]
NICKNAME=["bot"]     # 机器人昵称

# === SillyTavern Bridge 配置 ===
ST_BASE_URL=http://127.0.0.1:8000  # SillyTavern 地址
ST_CHAT_SOURCE=deepseek             # AI 后端名称（对应 ST 连接配置）
ST_MODEL=                           # 已废弃 — 留空，模型由 ST 连接设置指定
ST_TIMEOUT=120                      # 请求超时（秒）
ST_MAX_RESPONSE_LENGTH=250          # 兜底最大回复长度（实际按下面两档走）

# === 社交引擎 ===
# 总开关（各群还可用 /social on|off 单独控制）
ST_SOCIAL_ENABLED=true
# 上下文窗口：喂给模型的最大记录条数
ST_CONTEXT_WINDOW=50

# --- 观望期检查点 ---
# 攒够 N 条新消息才触发一次"看一眼"（轻量档）
ST_CHECKPOINT_THRESHOLD=3
# 两次检查点之间的最小间隔（秒）
ST_CHECKPOINT_COOLDOWN=90
# 引擎扫描间隔（秒）
ST_TICK_INTERVAL=2

# --- 活跃期（注意力惯性）---
# 活跃时长上下限（秒）：进入活跃期后随机取值，到点自然收尾退场
ST_ACTIVE_MIN=300
ST_ACTIVE_MAX=600
# 活跃期批量检查新消息的间隔上下限（秒）
ST_ACTIVE_CHECK_MIN=10
ST_ACTIVE_CHECK_MAX=30
# 冷场窗口（秒）：这么久没新消息就退场/试探
ST_COLD_WINDOW=360
# 冷场时试探（主动说一句）的概率 %
ST_PROBE_PROBABILITY=30
# 两次试探最小间隔（秒）
ST_PROBE_COOLDOWN=1200
# 试探后等人回应的窗口上下限（秒），没人回应回观望
ST_PROBE_WAIT_MIN=120
ST_PROBE_WAIT_MAX=300

# --- 发送节奏（模拟真人打字）---
# 看到 → 打字的回复延迟上下限（秒）
ST_REPLY_DELAY_MIN=2
ST_REPLY_DELAY_MAX=8
# 分条间隔上下限（秒）
ST_BURST_MIN=1
ST_BURST_MAX=3
# 长间隔概率（0-1）与上下限（秒）
ST_BURST_LONG_PROBABILITY=0.2
ST_BURST_LONG_MIN=8
ST_BURST_LONG_MAX=10
# 单条气泡硬上限字数 / 一回合最多几条气泡
ST_MAX_MSG_CHARS=500
ST_MAX_BUBBLES=6

# --- 生成两档 ---
# 轻量档（观望期看一眼）max_tokens / 重量档（正式回复）max_tokens
ST_LIGHT_TOKENS=80
ST_HEAVY_TOKENS=250

# --- [WAKE] 成本护栏 ---
# AI 可预约的最小/最大潜水时长（秒）
ST_WAKE_MIN=600
ST_WAKE_MAX=7200
# 每会话每天最多唤醒次数
ST_WAKE_DAILY_LIMIT=30

# --- 动作循环 ---
# 每回合最多几次生成（防循环失控）
ST_MAX_STEPS=5

# 兴趣关键词（命中即触发"看一眼"，逗号分隔；从角色卡兴趣提取）
ST_INTEREST_KEYWORDS=偶像,唱歌,跳舞,柴犬,小狗,小猫,动画,漫画,游戏,甜食,点心,汉堡肉

# === 全链路追踪日志（logs/trace.log） ===
# 四个阶段各记一行：QQ◀ 输入 / ST▶ 请求 / ST◀ 响应 / QQ▶ 输出
# 每天 0 点轮转新文件，超过保留天数的旧文件自动删除；实时查看：
#   tail -f logs/trace.log
ST_TRACE_ENABLED=true                # 总开关
ST_TRACE_MAX_CHARS=4000              # 单条记录长度上限（过长截断）
ST_TRACE_KEEP_DAYS=7                 # 保留天数
